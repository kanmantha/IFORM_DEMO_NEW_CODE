@model IReadOnlyList<IForm.Domain.Entities.Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-bell me-2 text-primary"></i>Notifications</h1>
    <form asp-action="MarkAllRead" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-check2-all me-1"></i>Mark all read</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-bell-slash" style="font-size:3rem"></i>
        <p class="mt-2 mb-0">No notifications.</p>
    </div>
}
else
{
    @foreach (var n in Model)
    {
        <div class="list-item @(n.IsRead ? "opacity-75" : "")" @(n.IsRead ? "" : "style=border-left:3px solid var(--bs-primary)")>
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-bold">@n.Title</div>
                    <div class="small text-muted">@n.Message</div>
                    <div class="small text-muted mt-1">@n.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</div>
                </div>
                @if (!n.IsRead)
                {
                    <form asp-action="MarkRead" method="post">
                        <input type="hidden" name="id" value="@n.Id" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Mark read"><i class="bi bi-check2"></i></button>
                    </form>
                }
            </div>
        </div>
    }
}
