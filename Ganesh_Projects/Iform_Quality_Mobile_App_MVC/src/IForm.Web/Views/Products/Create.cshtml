@model IForm.Application.DTOs.CreateProductRequest
@{
    ViewData["Title"] = "Add Product";
    var categories = ViewBag.Categories as IReadOnlyList<IForm.Application.DTOs.ProductCategoryDto> ?? new List<IForm.Application.DTOs.ProductCategoryDto>();
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0">Add Product</h1>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ProductCode" class="form-label">Code <span class="text-danger">*</span></label>
                    <input asp-for="ProductCode" class="form-control" />
                    <span asp-validation-for="ProductCode" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ProductName" class="form-label">Name <span class="text-danger">*</span></label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(categories, "Id", "Name"))">
                        <option value="">None</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Unit" class="form-label">Unit</label>
                    <input asp-for="Unit" class="form-control" placeholder="nos / sqm / mtr" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Specification" class="form-label">Specification</label>
                <input asp-for="Specification" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Material" class="form-label">Material</label>
                <input asp-for="Material" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Save Product</button>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
