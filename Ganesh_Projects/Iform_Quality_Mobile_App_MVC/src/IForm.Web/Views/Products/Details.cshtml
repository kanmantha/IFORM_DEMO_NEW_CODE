@model IForm.Application.DTOs.ProductDto
@{
    ViewData["Title"] = Model.ProductCode;
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0">@Model.ProductCode</h1>
    <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary") ms-2">@(Model.IsActive ? "Active" : "Inactive")</span>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Product Details</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th class="text-muted">Code</th><td>@Model.ProductCode</td></tr>
                        <tr><th class="text-muted">Name</th><td>@Model.ProductName</td></tr>
                        <tr><th class="text-muted">Category</th><td>@Model.CategoryName</td></tr>
                        <tr><th class="text-muted">Specification</th><td>@Model.Specification</td></tr>
                        <tr><th class="text-muted">Material</th><td>@Model.Material</td></tr>
                        <tr><th class="text-muted">Unit</th><td>@Model.Unit</td></tr>
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <tr><th class="text-muted">Description</th><td>@Model.Description</td></tr>
                        }
                        <tr><th class="text-muted">Used In Projects</th><td>@(Model.ProjectIds.Count > 0 ? string.Join(", ", Model.ProjectIds) : "All")</td></tr>
                    </tbody>
                </table>
                <a asp-controller="Queries" asp-action="Create" asp-route-productCode="@Model.ProductCode" asp-route-productName="@Model.ProductName" class="btn btn-primary mt-3"><i class="bi bi-plus-circle me-1"></i>Report Query for this Product</a>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Photo</strong></div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                {
                    <a asp-controller="Files" asp-action="Download" asp-route-path="@Model.PhotoPath" target="_blank">
                        <img src="@Url.Action("Download", "Files", new { path = Model.PhotoPath })" class="img-fluid rounded" alt="@Model.ProductName" />
                    </a>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-image" style="font-size:3rem"></i>
                        <p class="mt-2 mb-0">No photo available.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
