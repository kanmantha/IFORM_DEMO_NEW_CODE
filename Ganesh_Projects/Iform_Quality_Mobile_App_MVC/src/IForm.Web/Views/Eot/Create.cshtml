@model IForm.Application.DTOs.CreateEotRequest
@using IForm.Domain.Enums
@{
    ViewData["Title"] = "New EOT";
    var projects = ViewBag.Projects as IReadOnlyList<IForm.Application.DTOs.ProjectListItemDto> ?? new List<IForm.Application.DTOs.ProjectListItemDto>();
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0"><i class="bi bi-journal-plus me-2 text-primary"></i>New EOT Claim</h1>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">EOT Header</div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label">Project <span class="text-danger">*</span></label>
                <select asp-for="ProjectId" class="form-select" asp-items="@(new SelectList(projects, "Id", "ProjectName"))">
                    <option value="">Select project...</option>
                </select>
                <span asp-validation-for="ProjectId" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ClientEotNumber" class="form-label">Client EOT Number</label>
                    <input asp-for="ClientEotNumber" class="form-control" placeholder="e.g. EOT-2026-001" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="FinancialYear" class="form-label">Financial Year</label>
                    <input asp-for="FinancialYear" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="RevisionNumber" class="form-label">Revision</label>
                    <input asp-for="RevisionNumber" type="number" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Scenario" class="form-label">Scenario</label>
                    <select asp-for="Scenario" class="form-select">
                        @foreach (var s in Enum.GetValues<EotScenario>())
                        {
                            <option value="@((int)s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label">Category</label>
                    <select asp-for="Category" class="form-select">
                        @foreach (var c in Enum.GetValues<EotCategory>())
                        {
                            <option value="@((int)c)">@c</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Dates & Impact</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SpaDate" class="form-label">SPA Date</label>
                    <input asp-for="SpaDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DesignRevisionDate" class="form-label">Design Revision Date</label>
                    <input asp-for="DesignRevisionDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DelayDays" class="form-label">Delay (days)</label>
                    <input asp-for="DelayDays" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CostEscalation" class="form-label">Cost Escalation</label>
                    <input asp-for="CostEscalation" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EstimatedTimeImpactDays" class="form-label">Estimated Time Impact (days)</label>
                    <input asp-for="EstimatedTimeImpactDays" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EstimatedCostImpact" class="form-label">Estimated Cost Impact</label>
                    <input asp-for="EstimatedCostImpact" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Details</div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Reason</label>
                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Reference" class="form-label">Reference</label>
                    <input asp-for="Reference" class="form-control" placeholder="Document/letter reference" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ChangeProposedBy" class="form-label">Change Proposed By</label>
                    <input asp-for="ChangeProposedBy" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100 mb-4"><i class="bi bi-save me-1"></i>Create EOT</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
