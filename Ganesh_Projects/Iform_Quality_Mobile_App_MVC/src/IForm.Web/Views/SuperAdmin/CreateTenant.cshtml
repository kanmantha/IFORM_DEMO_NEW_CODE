@model IForm.Application.DTOs.CreateTenantRequest
@{
    ViewData["Title"] = "Create Tenant";
}
<div class="d-flex align-items-center mb-3">
    <a asp-action="Tenants" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0">Create Tenant</h1>
</div>

<form asp-action="CreateTenant" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Tenant</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Company Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Contact Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="PlanName" class="form-label">Plan</label>
                <select asp-for="PlanName" class="form-select">
                    <option value="TRIAL">TRIAL</option>
                    <option value="STARTER">STARTER</option>
                    <option value="BUSINESS">BUSINESS</option>
                    <option value="ENTERPRISE">ENTERPRISE</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Tenant Admin</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenantAdminName" class="form-label">Name <span class="text-danger">*</span></label>
                    <input asp-for="TenantAdminName" class="form-control" />
                    <span asp-validation-for="TenantAdminName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TenantAdminEmail" class="form-label">Email <span class="text-danger">*</span></label>
                    <input asp-for="TenantAdminEmail" class="form-control" type="email" />
                    <span asp-validation-for="TenantAdminEmail" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="TenantAdminPassword" class="form-label">Password <span class="text-danger">*</span></label>
                <input asp-for="TenantAdminPassword" class="form-control" type="password" />
                <span asp-validation-for="TenantAdminPassword" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-buildings me-1"></i>Create Tenant</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
