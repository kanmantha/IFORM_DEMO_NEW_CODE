@{
    ViewData["Title"] = "Home";
}

<style>
    .home-module-card {
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .home-module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
    }
</style>

<div class="row justify-content-center">
    <div class="col-12">
        <div class="text-center my-4">
            <h1 class="display-6 fw-bold">I-FORM Site Query</h1>
            <p class="text-muted">Choose a module to get started</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-sm-6 col-lg-4">
                <a class="card h-100 text-decoration-none shadow-sm home-module-card" asp-controller="Home" asp-action="WorkPermit">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-card-checklist display-1 text-primary"></i>
                        <h4 class="mt-3 mb-0 fw-semibold text-dark">Work Permit</h4>
                        <p class="text-muted small mb-0">Manage site work permits</p>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-4">
                <a class="card h-100 text-decoration-none shadow-sm home-module-card" asp-controller="Home" asp-action="Quality">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-patch-check display-1 text-success"></i>
                        <h4 class="mt-3 mb-0 fw-semibold text-dark">Quality</h4>
                        <p class="text-muted small mb-0">Quality checks and records</p>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-4">
                <a class="card h-100 text-decoration-none shadow-sm home-module-card" asp-controller="Home" asp-action="Safety">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-shield-check display-1 text-warning"></i>
                        <h4 class="mt-3 mb-0 fw-semibold text-dark">Safety</h4>
                        <p class="text-muted small mb-0">Safety compliance and audits</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
