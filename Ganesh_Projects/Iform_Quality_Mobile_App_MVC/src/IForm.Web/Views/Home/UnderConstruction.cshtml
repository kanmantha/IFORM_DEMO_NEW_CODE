@{
    var feature = ViewData["Feature"] as string ?? "This module";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="text-center my-5">
            <i class="bi bi-cone-striped display-1 text-warning"></i>
            <h1 class="display-6 fw-bold mt-3">@feature</h1>
            <h2 class="text-muted">Site Under Construction</h2>
            <p class="text-muted mt-3">
                This module is being built and will be available soon.<br />
                Please check back later.
            </p>
            <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>
