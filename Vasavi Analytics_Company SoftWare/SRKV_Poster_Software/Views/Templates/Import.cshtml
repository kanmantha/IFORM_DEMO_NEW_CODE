@model TemplateImportViewModel
@{
    ViewData["Title"] = "Import Poster Template";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Import a Poster Template</h1>
        <p class="text-muted mb-0">
            Upload an old poster, erase the old text and unwanted logos, protect the
            logos you want to keep, and we'll turn it into a template. Today's matter
            is then rendered into the erased text areas automatically.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<form asp-action="Import" method="post" enctype="multipart/form-data" id="importForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BoxesJson" />

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><strong>1 · Details</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Weekend Menu Board" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Sector" class="form-label"></label>
                        <select asp-for="Sector" class="form-select">
                            @foreach (var s in Model.SectorOptions)
                            {
                                <option value="@s.Value">@s.Label</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"
                                  placeholder="What's this layout for?"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-1">
                        <label asp-for="Upload" class="form-label"></label>
                        <input asp-for="Upload" type="file" id="fileInput" accept=".png,.jpg,.jpeg,.webp" class="form-control" />
                        <div class="form-text">PNG, JPG or WEBP, up to 10 MB. A portrait poster works best.</div>
                        <span asp-validation-for="Upload" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><strong>2 · Mark the layout</strong></div>
                <div class="card-body">
                    <p class="small text-muted mb-2" id="toolHint">
                        Click <strong>Erase Text</strong> or <strong>Erase Logos</strong> to
                        auto-detect areas — you confirm each one before anything is removed.
                        Dragging on the poster marks an area manually.
                    </p>
                    <div class="btn-group w-100 mb-2" role="group" aria-label="Tool">
                        <button type="button" class="btn btn-outline-danger active" id="toolErase">Erase Text</button>
                        <button type="button" class="btn btn-outline-warning" id="toolLogos">Erase Logos</button>
                        <button type="button" class="btn btn-outline-success" id="toolKeep">Keep Logo</button>
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClear">Clear all</button>
                    </div>
                    <div id="boxList" class="d-flex flex-column gap-1"></div>
                    <div id="boxCount" class="small text-muted mt-2">No areas marked yet.</div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-gradient">Create Template</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Your poster</strong>
                    <span class="small text-muted">Tool: <span id="toolLabel" class="text-danger">Erase Text</span></span>
                </div>
                <div class="card-body text-center">
                    <div id="canvasWrap" class="d-none mx-auto" style="max-width:420px;">
                        <canvas id="editCanvas" class="img-fluid border rounded" style="max-width:100%; cursor:crosshair;"></canvas>
                    </div>
                    <div id="emptyHint" class="text-muted py-5">
                        Choose a poster image above to start marking it.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="modal fade" id="detectModal" tabindex="-1" aria-labelledby="detectTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detectTitle">Confirm areas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted" id="detectIntro"></p>
                <div id="detectList"></div>
                <div class="form-text">Highlighted boxes are shown on the poster preview.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="detectConfirm">Apply</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const canvas = document.getElementById('editCanvas');
            const ctx = canvas.getContext('2d');
            const fileInput = document.getElementById('fileInput');
            const canvasWrap = document.getElementById('canvasWrap');
            const emptyHint = document.getElementById('emptyHint');
            const boxList = document.getElementById('boxList');
            const boxCount = document.getElementById('boxCount');
            const boxesInput = document.getElementById('BoxesJson');
            const toolErase = document.getElementById('toolErase');
            const toolLogos = document.getElementById('toolLogos');
            const toolKeep = document.getElementById('toolKeep');
            const toolLabel = document.getElementById('toolLabel');

            const TOOLS = {
                'erase': {
                    label: 'Erase Text', color: '#dc3545', cls: 'danger',
                    hint: 'Click <strong>Erase Text</strong> to auto-detect old text areas - you confirm each one before anything is removed. Dragging marks an area manually.'
                },
                'erase-logo': {
                    label: 'Erase Logos', color: '#fd7e14', cls: 'warning',
                    hint: 'Click <strong>Erase Logos</strong> to auto-detect logos - you confirm each one before removal. Dragging marks an area manually.'
                },
                'keep': {
                    label: 'Keep Logo', color: '#198754', cls: 'success',
                    hint: 'Drag on the poster to protect a logo. Kept areas are never erased by any tool.'
                }
            };
            const TOOL_IDS = { 'erase': toolErase, 'erase-logo': toolLogos, 'keep': toolKeep };

            let img = null;
            let boxes = [];
            let tool = 'erase';
            let drawing = false;
            let start = { x: 0, y: 0 };
            let drag = null;
            let pending = [];
            let modal = null;

            function setTool(t) {
                tool = t;
                Object.keys(TOOL_IDS).forEach(k => TOOL_IDS[k].classList.toggle('active', k === t));
                toolLabel.textContent = TOOLS[t].label;
                toolLabel.className = 'text-' + TOOLS[t].cls;
                document.getElementById('toolHint').innerHTML = TOOLS[t].hint;
            }

            toolErase.addEventListener('click', () => { setTool('erase'); detectAndConfirm('text'); });
            toolLogos.addEventListener('click', () => { setTool('erase-logo'); detectAndConfirm('logos'); });
            toolKeep.addEventListener('click', () => setTool('keep'));

            function pos(e) {
                const r = canvas.getBoundingClientRect();
                const x = (e.clientX - r.left) * (canvas.width / r.width);
                const y = (e.clientY - r.top) * (canvas.height / r.height);
                return {
                    x: Math.max(0, Math.min(canvas.width, x)),
                    y: Math.max(0, Math.min(canvas.height, y))
                };
            }

            function norm(p) {
                return { x: p.x / canvas.width, y: p.y / canvas.height };
            }

            function overlapRatio(a, b) {
                const x1 = Math.max(a.x, b.x);
                const y1 = Math.max(a.y, b.y);
                const x2 = Math.min(a.x + a.w, b.x + b.w);
                const y2 = Math.min(a.y + a.h, b.y + b.h);
                const inter = Math.max(0, x2 - x1) * Math.max(0, y2 - y1);
                return inter / Math.max(0.0001, a.w * a.h);
            }

            function render() {
                if (!img) return;
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                const drawBox = (b, color, opts) => {
                    opts = opts || {};
                    const x = b.x * canvas.width;
                    const y = b.y * canvas.height;
                    const w = b.w * canvas.width;
                    const h = b.h * canvas.height;
                    ctx.save();
                    ctx.fillStyle = color + (opts.fill || '33');
                    ctx.strokeStyle = color;
                    ctx.lineWidth = 2;
                    if (opts.dash) ctx.setLineDash([6, 4]);
                    ctx.fillRect(x, y, w, h);
                    ctx.strokeRect(x, y, w, h);
                    if (opts.label) {
                        ctx.setLineDash([]);
                        ctx.font = 'bold 11px sans-serif';
                        const tw = ctx.measureText(opts.label).width + 8;
                        ctx.fillStyle = color;
                        ctx.fillRect(x, Math.max(0, y - 14), tw, 14);
                        ctx.fillStyle = '#fff';
                        ctx.fillText(opts.label, x + 4, Math.max(10, y - 3));
                    }
                    ctx.restore();
                };

                boxes.forEach((b, i) => drawBox(b, TOOLS[b.type] ? TOOLS[b.type].color : '#dc3545',
                    { label: (TOOLS[b.type] ? TOOLS[b.type].label : b.type) + ' ' + (i + 1) }));

                pending.forEach(b => {
                    if (!b._skip) drawBox(b, TOOLS[b.type].color, { dash: true, fill: b._hover ? '66' : '22' });
                });

                if (drag) {
                    const x = Math.min(drag.a.x, drag.b.x);
                    const y = Math.min(drag.a.y, drag.b.y);
                    const w = Math.abs(drag.b.x - drag.a.x);
                    const h = Math.abs(drag.b.y - drag.a.y);
                    drawBox({ x: x / canvas.width, y: y / canvas.height, w: w / canvas.width, h: h / canvas.height },
                        TOOLS[tool].color, { fill: '55' });
                }
            }

            function sync() {
                boxesInput.value = JSON.stringify(boxes.map(b => ({
                    type: b.type, x: +b.x.toFixed(3), y: +b.y.toFixed(3), w: +b.w.toFixed(3), h: +b.h.toFixed(3)
                })));
                renderBoxList();
                render();
            }

            function renderBoxList() {
                boxList.innerHTML = '';
                boxes.forEach((b, i) => {
                    const div = document.createElement('div');
                    div.className = 'input-group input-group-sm';
                    const span = document.createElement('span');
                    span.className = 'input-group-text text-' + (TOOLS[b.type] ? TOOLS[b.type].cls : 'danger');
                    span.textContent = (TOOLS[b.type] ? TOOLS[b.type].label : b.type) + ' ' + (i + 1);
                    const lbl = document.createElement('span');
                    lbl.className = 'form-control';
                    lbl.textContent = (b.x * 100).toFixed(0) + '% × ' + (b.y * 100).toFixed(0) + '% · ' + (b.w * 100).toFixed(0) + '% × ' + (b.h * 100).toFixed(0) + '%';
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-danger';
                    btn.textContent = '✕';
                    btn.addEventListener('click', () => { boxes.splice(i, 1); sync(); });
                    div.appendChild(span);
                    div.appendChild(lbl);
                    div.appendChild(btn);
                    boxList.appendChild(div);
                });
                const n = t => boxes.filter(b => b.type === t).length;
                boxCount.textContent = boxes.length === 0
                    ? 'No areas marked yet.'
                    : boxes.length + ' area' + (boxes.length === 1 ? '' : 's') + ' marked (erase: ' + n('erase') +
                      ', del logo: ' + n('erase-logo') + ', keep: ' + n('keep') + ').';
            }

            canvas.addEventListener('mousedown', e => {
                if (!img) return;
                drawing = true;
                start = pos(e);
                drag = { a: start, b: start };
            });
            canvas.addEventListener('mousemove', e => {
                if (!drawing) return;
                drag.b = pos(e);
                render();
            });
            window.addEventListener('mouseup', () => {
                if (!drawing) return;
                drawing = false;
                if (drag && Math.abs(drag.b.x - drag.a.x) > 3 && Math.abs(drag.b.y - drag.a.y) > 3) {
                    const a = norm(drag.a);
                    const b = norm(drag.b);
                    boxes.push({
                        type: tool,
                        x: Math.min(a.x, b.x),
                        y: Math.min(a.y, b.y),
                        w: Math.abs(b.x - a.x),
                        h: Math.abs(b.y - a.y)
                    });
                }
                drag = null;
                sync();
            });

            fileInput.addEventListener('change', () => {
                const file = fileInput.files && fileInput.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = e => {
                    const image = new Image();
                    image.onload = () => {
                        img = image;
                        const maxW = 420;
                        canvas.width = Math.min(maxW, image.naturalWidth);
                        canvas.height = Math.round(canvas.width * image.naturalHeight / image.naturalWidth);
                        canvasWrap.classList.remove('d-none');
                        emptyHint.style.display = 'none';
                        boxes = [];
                        pending = [];
                        sync();
                    };
                    image.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });

            document.getElementById('btnClear').addEventListener('click', () => {
                boxes = [];
                pending = [];
                sync();
            });

            // ------------------------------------------------ auto detect + confirm

            function detectAndConfirm(kind) {
                const file = fileInput.files && fileInput.files[0];
                if (!file) {
                    alert('Choose a poster image first.');
                    return;
                }
                const btn = kind === 'logos' ? toolLogos : toolErase;
                const old = btn.textContent;
                btn.disabled = true;
                btn.textContent = 'Detecting…';
                const fd = new FormData();
                fd.append('upload', file);
                fetch('/Templates/AutoDetect', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(data => {
                        const raw = kind === 'logos' ? (data.logos || []) : (data.text || []);
                        const type = kind === 'logos' ? 'erase-logo' : 'erase';
                        let cands = raw
                            .filter(b => b.w > 0 && b.h > 0)
                            .map(b => ({ type: type, x: b.x, y: b.y, w: b.w, h: b.h }));
                        if (type === 'erase') {
                            cands = cands.filter(c => !boxes.some(b => b.type === 'keep' && overlapRatio(c, b) > 0.5));
                        }
                        if (cands.length === 0) {
                            alert(kind === 'logos'
                                ? 'No logos detected automatically. Drag on the poster to mark them.'
                                : 'No text areas detected automatically. Drag on the poster to mark them.');
                            return;
                        }
                        openConfirm(kind, cands);
                    })
                    .catch(() => alert('Auto-detect failed. Draw the areas manually.'))
                    .finally(() => {
                        btn.disabled = false;
                        btn.textContent = old;
                    });
            }

            function openConfirm(kind, cands) {
                pending = cands.map(b => Object.assign({}, b, { _skip: false, _hover: false }));
                const isLogos = kind === 'logos';
                document.getElementById('detectTitle').textContent =
                    isLogos ? 'Confirm logos to remove' : 'Confirm text areas to erase';
                document.getElementById('detectIntro').textContent = isLogos
                    ? 'We found these possible logos. Untick anything that should stay:'
                    : 'We found these possible text areas. Untick anything that should stay:';
                const list = document.getElementById('detectList');
                list.innerHTML = '';
                pending.forEach((b, i) => {
                    const div = document.createElement('div');
                    div.className = 'form-check';
                    const input = document.createElement('input');
                    input.type = 'checkbox';
                    input.className = 'form-check-input';
                    input.checked = true;
                    input.id = 'det' + i;
                    input.addEventListener('change', () => { b._skip = !input.checked; render(); });
                    const label = document.createElement('label');
                    label.className = 'form-check-label';
                    label.htmlFor = 'det' + i;
                    label.textContent = areaText(b);
                    label.addEventListener('mouseenter', () => { b._hover = true; render(); });
                    label.addEventListener('mouseleave', () => { b._hover = false; render(); });
                    div.appendChild(input);
                    div.appendChild(label);
                    list.appendChild(div);
                });
                const confirmBtn = document.getElementById('detectConfirm');
                confirmBtn.className = 'btn btn-' + (isLogos ? 'warning' : 'danger');
                confirmBtn.textContent = isLogos ? 'Remove selected logos' : 'Erase selected areas';
                render();
                modal.show();
            }

            function areaText(b) {
                return (TOOLS[b.type] ? TOOLS[b.type].label : b.type) +
                    ' · x ' + Math.round(b.x * 100) + '% · y ' + Math.round(b.y * 100) + '%' +
                    ' · ' + Math.round(b.w * 100) + '% × ' + Math.round(b.h * 100) + '%';
            }

            const detectModalEl = document.getElementById('detectModal');
            modal = new bootstrap.Modal(detectModalEl);

            document.getElementById('detectConfirm').addEventListener('click', () => {
                pending.forEach(b => {
                    if (!b._skip) {
                        boxes.push({ type: b.type, x: b.x, y: b.y, w: b.w, h: b.h });
                    }
                });
                pending = [];
                sync();
                modal.hide();
            });

            detectModalEl.addEventListener('hidden.bs.modal', () => {
                pending = [];
                render();
            });
        })();
    </script>
}