@model TemplateImportViewModel
@{
    ViewData["Title"] = "Create or Update a Poster";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Create or Update a Poster</h1>
        <p class="text-muted mb-0">
            Upload an old design and tell the assistant what to change — it removes text,
            drops unwanted logos and refreshes the colours. Your original upload is always kept safe.
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-update-btn" data-bs-toggle="tab" data-bs-target="#tab-update"
                type="button" role="tab" aria-selected="true">
            🖼️ Update an old poster
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-new-btn" data-bs-toggle="tab" data-bs-target="#tab-new"
                type="button" role="tab" aria-selected="false">
            ✨ Create a new poster
        </button>
    </li>
</ul>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-update" role="tabpanel">
        <form asp-action="Import" method="post" enctype="multipart/form-data" id="importForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BoxesJson" />

            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card">
                        <div class="card-header"><strong>1 · Details &amp; upload</strong></div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Weekend Menu Board" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Sector" class="form-label"></label>
                                <select asp-for="Sector" class="form-select">
                                    @foreach (var s in Model.SectorOptions)
                                    {
                                        <option value="@s.Value">@s.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Upload" class="form-label"></label>
                                <input asp-for="Upload" type="file" id="fileInput" accept=".png,.jpg,.jpeg,.webp" class="form-control" />
                                <div class="form-text">PNG, JPG or WEBP, up to 10 MB. A portrait poster works best.</div>
                                <span asp-validation-for="Upload" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3 border-primary">
                        <div class="card-header bg-primary-subtle"><strong>🤖 Tell the assistant what to change</strong></div>
                        <div class="card-body">
                            <textarea id="aiText" class="form-control mb-2" rows="3"
                                      placeholder='e.g. "remove all text and logos, make it blue"'></textarea>
                            <div class="d-flex flex-wrap gap-1 mb-2" id="aiChips">
                                <button type="button" class="btn btn-sm btn-outline-secondary">remove all text</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">remove text and logos</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">make it black and white</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">make it green</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">new background</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">enhance the colours</button>
                            </div>
                            <button type="button" class="btn btn-gradient w-100" id="aiApply">Apply instruction</button>
                            <div id="aiMsg" class="alert d-none mt-2 mb-0 small py-2" role="alert"></div>
                            <div id="aiResultWrap" class="d-none mt-2 text-center">
                                <img id="aiThumb" class="img-fluid border rounded" style="max-height:260px;" alt="Updated preview" />
                                <div class="form-text">Preview of your updated poster — erasures are marked on the editor.</div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header"><strong>2 · Mark the layout (optional)</strong></div>
                        <div class="card-body">
                            <p class="small text-muted mb-2" id="toolHint">
                                The assistant above usually handles erasing. Prefer manual control?
                                Click <strong>Erase Text</strong> or <strong>Erase Logos</strong> to auto-detect
                                areas, or drag on the poster to mark one yourself.
                            </p>
                            <div class="btn-group w-100 mb-2" role="group" aria-label="Tool">
                                <button type="button" class="btn btn-outline-danger active" id="toolErase">Erase Text</button>
                                <button type="button" class="btn btn-outline-warning" id="toolLogos">Erase Logos</button>
                                <button type="button" class="btn btn-outline-success" id="toolKeep">Keep Logo</button>
                            </div>
                            <div class="d-flex gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClear">Clear all</button>
                            </div>
                            <div id="boxList" class="d-flex flex-column gap-1"></div>
                            <div id="boxCount" class="small text-muted mt-2">No areas marked yet.</div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header"><strong>3 · Refresh colours</strong></div>
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input treat-radio" type="radio" name="TreatmentKind" id="treatOriginal" value="original" checked />
                                <label class="form-check-label" for="treatOriginal">Keep original colours</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input treat-radio" type="radio" name="TreatmentKind" id="treatTint" value="tint" />
                                <label class="form-check-label" for="treatTint">Colour tint wash</label>
                            </div>
                            <div class="ms-4 mb-2 d-none" id="tintControls">
                                <input type="color" class="form-control form-control-color d-inline-block align-middle me-2"
                                       id="tintHex" name="TintHex" value="#1e88e5" title="Tint colour" />
                                <input type="range" class="form-range d-inline-block align-middle" style="max-width:180px;"
                                       id="tintStrengthRange" min="10" max="85" value="45" />
                                <span class="small text-muted align-middle" id="tintStrengthLabel">45%</span>
                                <input type="hidden" id="TintStrength" name="TintStrength" value="0.45" />
                            </div>
                            <div class="form-check">
                                <input class="form-check-input treat-radio" type="radio" name="TreatmentKind" id="treatEnhance" value="enhance" />
                                <label class="form-check-label" for="treatEnhance">Enhance colours (fix faded prints)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input treat-radio" type="radio" name="TreatmentKind" id="treatGray" value="grayscale" />
                                <label class="form-check-label" for="treatGray">Black &amp; white</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input treat-radio" type="radio" name="TreatmentKind" id="treatFresh" value="fresh" />
                                <label class="form-check-label" for="treatFresh">Fresh new background</label>
                            </div>
                            <div class="ms-4 mt-1 d-none" id="freshControls">
                                <select class="form-select form-select-sm d-inline-block w-auto me-2" id="freshTheme" name="FreshTheme">
                                    <option value="colorful">Colourful gradient</option>
                                    <option value="light">Light &amp; clean</option>
                                    <option value="dark">Dark premium</option>
                                </select>
                                <input type="color" class="form-control form-control-color d-inline-block align-middle"
                                       id="freshAccent" name="FreshAccent" value="#ffd54f" title="Accent glow" />
                            </div>
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnTreatPreview">See colour preview</button>
                                <span class="small text-muted d-none" id="treatNote">Final import applies erasures + colour at full quality.</span>
                            </div>
                            <div class="mt-2 d-none" id="treatThumbWrap">
                                <img id="treatThumb" class="img-fluid border rounded" style="max-height:220px;" alt="Colour preview" />
                            </div>
                        </div>
                    </div>

                    <div class="my-3 d-flex gap-2">
                        <button type="submit" class="btn btn-gradient">Create Updated Template</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>Your poster</strong>
                            <span class="small text-muted">Tool: <span id="toolLabel" class="text-danger">Erase Text</span></span>
                        </div>
                        <div class="card-body text-center">
                            <div id="canvasWrap" class="d-none mx-auto" style="max-width:420px;">
                                <canvas id="editCanvas" class="img-fluid border rounded" style="max-width:100%; cursor:crosshair;"></canvas>
                            </div>
                            <div id="emptyHint" class="text-muted py-5">
                                Choose a poster image above to start updating it.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="tab-pane fade" id="tab-new" role="tabpanel">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card text-center shadow-sm">
                    <div class="card-body p-5">
                        <div style="font-size:2.6rem;">✨</div>
                        <h3 class="mb-2">Generate a fresh poster with AI</h3>
                        <p class="text-muted mb-4">
                            Describe the occasion in the Poster Studio — a festival, a sale, an event —
                            pick a date from the calendar and get ready-to-share designs instantly.
                        </p>
                        <a href="/Studio" class="btn btn-gradient btn-lg px-4">Open Poster Studio</a>
                        <hr class="my-4" />
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <a class="btn btn-sm btn-outline-secondary" href="/Studio?prompt=Diwali%20greetings%20for%20my%20customers">🪔 Diwali</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/Studio?prompt=Independence%20Day%20celebration">🇮🇳 Independence Day</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/Studio?prompt=Mega%20sale%20announcement">🏷️ Mega Sale</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/Studio?prompt=School%20annual%20day%20function">🏫 School Event</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detectModal" tabindex="-1" aria-labelledby="detectTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detectTitle">Confirm areas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted" id="detectIntro"></p>
                <div id="detectList"></div>
                <div class="form-text">Highlighted boxes are shown on the poster preview.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="detectConfirm">Apply</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const canvas = document.getElementById('editCanvas');
            const ctx = canvas.getContext('2d');
            const fileInput = document.getElementById('fileInput');
            const canvasWrap = document.getElementById('canvasWrap');
            const emptyHint = document.getElementById('emptyHint');
            const boxList = document.getElementById('boxList');
            const boxCount = document.getElementById('boxCount');
            const boxesInput = document.getElementById('BoxesJson');
            const toolErase = document.getElementById('toolErase');
            const toolLogos = document.getElementById('toolLogos');
            const toolKeep = document.getElementById('toolKeep');
            const toolLabel = document.getElementById('toolLabel');

            const TOOLS = {
                'erase': { label: 'Erase Text', color: '#dc3545', cls: 'danger' },
                'erase-logo': { label: 'Erase Logos', color: '#fd7e14', cls: 'warning' },
                'keep': { label: 'Keep Logo', color: '#198754', cls: 'success' }
            };
            const TOOL_IDS = { 'erase': toolErase, 'erase-logo': toolLogos, 'keep': toolKeep };

            let img = null;
            let boxes = [];
            let tool = 'erase';
            let drawing = false;
            let start = { x: 0, y: 0 };
            let drag = null;
            let pending = [];
            let modal = null;

            function setTool(t) {
                tool = t;
                Object.keys(TOOL_IDS).forEach(k => TOOL_IDS[k].classList.toggle('active', k === t));
                toolLabel.textContent = TOOLS[t].label;
                toolLabel.className = 'text-' + TOOLS[t].cls;
            }

            toolErase.addEventListener('click', () => { setTool('erase'); detectAndConfirm('text'); });
            toolLogos.addEventListener('click', () => { setTool('erase-logo'); detectAndConfirm('logos'); });
            toolKeep.addEventListener('click', () => setTool('keep'));

            function pos(e) {
                const r = canvas.getBoundingClientRect();
                const x = (e.clientX - r.left) * (canvas.width / r.width);
                const y = (e.clientY - r.top) * (canvas.height / r.height);
                return {
                    x: Math.max(0, Math.min(canvas.width, x)),
                    y: Math.max(0, Math.min(canvas.height, y))
                };
            }

            function norm(p) {
                return { x: p.x / canvas.width, y: p.y / canvas.height };
            }

            function overlapRatio(a, b) {
                const x1 = Math.max(a.x, b.x);
                const y1 = Math.max(a.y, b.y);
                const x2 = Math.min(a.x + a.w, b.x + b.w);
                const y2 = Math.min(a.y + a.h, b.y + b.h);
                const inter = Math.max(0, x2 - x1) * Math.max(0, y2 - y1);
                return inter / Math.max(0.0001, a.w * a.h);
            }

            function render() {
                if (!img) return;
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                const drawBox = (b, color, opts) => {
                    opts = opts || {};
                    const x = b.x * canvas.width;
                    const y = b.y * canvas.height;
                    const w = b.w * canvas.width;
                    const h = b.h * canvas.height;
                    ctx.save();
                    ctx.fillStyle = color + (opts.fill || '33');
                    ctx.strokeStyle = color;
                    ctx.lineWidth = 2;
                    if (opts.dash) ctx.setLineDash([6, 4]);
                    ctx.fillRect(x, y, w, h);
                    ctx.strokeRect(x, y, w, h);
                    if (opts.label) {
                        ctx.setLineDash([]);
                        ctx.font = 'bold 11px sans-serif';
                        const tw = ctx.measureText(opts.label).width + 8;
                        ctx.fillStyle = color;
                        ctx.fillRect(x, Math.max(0, y - 14), tw, 14);
                        ctx.fillStyle = '#fff';
                        ctx.fillText(opts.label, x + 4, Math.max(10, y - 3));
                    }
                    ctx.restore();
                };

                boxes.forEach((b, i) => drawBox(b, TOOLS[b.type] ? TOOLS[b.type].color : '#dc3545',
                    { label: (TOOLS[b.type] ? TOOLS[b.type].label : b.type) + ' ' + (i + 1) }));

                pending.forEach(b => {
                    if (!b._skip) drawBox(b, TOOLS[b.type].color, { dash: true, fill: b._hover ? '66' : '22' });
                });

                if (drag) {
                    const x = Math.min(drag.a.x, drag.b.x);
                    const y = Math.min(drag.a.y, drag.b.y);
                    const w = Math.abs(drag.b.x - drag.a.x);
                    const h = Math.abs(drag.b.y - drag.a.y);
                    drawBox({ x: x / canvas.width, y: y / canvas.height, w: w / canvas.width, h: h / canvas.height },
                        TOOLS[tool].color, { fill: '55' });
                }
            }

            function sync() {
                boxesInput.value = JSON.stringify(boxes.map(b => ({
                    type: b.type, x: +b.x.toFixed(3), y: +b.y.toFixed(3), w: +b.w.toFixed(3), h: +b.h.toFixed(3)
                })));
                renderBoxList();
                render();
            }

            function renderBoxList() {
                boxList.innerHTML = '';
                boxes.forEach((b, i) => {
                    const div = document.createElement('div');
                    div.className = 'input-group input-group-sm';
                    const span = document.createElement('span');
                    span.className = 'input-group-text text-' + (TOOLS[b.type] ? TOOLS[b.type].cls : 'danger');
                    span.textContent = (TOOLS[b.type] ? TOOLS[b.type].label : b.type) + ' ' + (i + 1);
                    const lbl = document.createElement('span');
                    lbl.className = 'form-control';
                    lbl.textContent = (b.x * 100).toFixed(0) + '% × ' + (b.y * 100).toFixed(0) + '% · ' + (b.w * 100).toFixed(0) + '% × ' + (b.h * 100).toFixed(0) + '%';
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-danger';
                    btn.textContent = '✕';
                    btn.addEventListener('click', () => { boxes.splice(i, 1); sync(); });
                    div.appendChild(span);
                    div.appendChild(lbl);
                    div.appendChild(btn);
                    boxList.appendChild(div);
                });
                const n = t => boxes.filter(b => b.type === t).length;
                boxCount.textContent = boxes.length === 0
                    ? 'No areas marked yet.'
                    : boxes.length + ' area' + (boxes.length === 1 ? '' : 's') + ' marked (erase: ' + n('erase') +
                      ', del logo: ' + n('erase-logo') + ', keep: ' + n('keep') + ').';
            }

            canvas.addEventListener('mousedown', e => {
                if (!img) return;
                drawing = true;
                start = pos(e);
                drag = { a: start, b: start };
            });
            canvas.addEventListener('mousemove', e => {
                if (!drawing) return;
                drag.b = pos(e);
                render();
            });
            window.addEventListener('mouseup', () => {
                if (!drawing) return;
                drawing = false;
                if (drag && Math.abs(drag.b.x - drag.a.x) > 3 && Math.abs(drag.b.y - drag.a.y) > 3) {
                    const a = norm(drag.a);
                    const b = norm(drag.b);
                    boxes.push({
                        type: tool,
                        x: Math.min(a.x, b.x),
                        y: Math.min(a.y, b.y),
                        w: Math.abs(b.x - a.x),
                        h: Math.abs(b.y - a.y)
                    });
                }
                drag = null;
                sync();
            });

            function loadImage() {
                const file = fileInput.files && fileInput.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = e => {
                    const image = new Image();
                    image.onload = () => {
                        img = image;
                        const maxW = 420;
                        canvas.width = Math.min(maxW, image.naturalWidth);
                        canvas.height = Math.round(canvas.width * image.naturalHeight / image.naturalWidth);
                        canvasWrap.classList.remove('d-none');
                        emptyHint.style.display = 'none';
                        sync();
                    };
                    image.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
            fileInput.addEventListener('change', loadImage);

            document.getElementById('btnClear').addEventListener('click', () => {
                boxes = [];
                pending = [];
                sync();
            });

            // ------------------------------------------------ auto detect + confirm

            function detectAndConfirm(kind) {
                const file = fileInput.files && fileInput.files[0];
                if (!file) {
                    alert('Choose a poster image first.');
                    return;
                }
                const btn = kind === 'logos' ? toolLogos : toolErase;
                const old = btn.textContent;
                btn.disabled = true;
                btn.textContent = 'Detecting…';
                const fd = new FormData();
                fd.append('upload', file);
                fetch('/Templates/AutoDetect', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(data => {
                        const raw = kind === 'logos' ? (data.logos || []) : (data.text || []);
                        const type = kind === 'logos' ? 'erase-logo' : 'erase';
                        let cands = raw
                            .filter(b => b.w > 0 && b.h > 0)
                            .map(b => ({ type: type, x: b.x, y: b.y, w: b.w, h: b.h }));
                        if (type === 'erase') {
                            cands = cands.filter(c => !boxes.some(b => b.type === 'keep' && overlapRatio(c, b) > 0.5));
                        }
                        if (cands.length === 0) {
                            alert(kind === 'logos'
                                ? 'No logos detected automatically. Drag on the poster to mark them.'
                                : 'No text areas detected automatically. Drag on the poster to mark them.');
                            return;
                        }
                        openConfirm(kind, cands);
                    })
                    .catch(() => alert('Auto-detect failed. Draw the areas manually.'))
                    .finally(() => {
                        btn.disabled = false;
                        btn.textContent = old;
                    });
            }

            function openConfirm(kind, cands) {
                pending = cands.map(b => Object.assign({}, b, { _skip: false, _hover: false }));
                const isLogos = kind === 'logos';
                document.getElementById('detectTitle').textContent =
                    isLogos ? 'Confirm logos to remove' : 'Confirm text areas to erase';
                document.getElementById('detectIntro').textContent = isLogos
                    ? 'We found these possible logos. Untick anything that should stay:'
                    : 'We found these possible text areas. Untick anything that should stay:';
                const list = document.getElementById('detectList');
                list.innerHTML = '';
                pending.forEach((b, i) => {
                    const div = document.createElement('div');
                    div.className = 'form-check';
                    const input = document.createElement('input');
                    input.type = 'checkbox';
                    input.className = 'form-check-input';
                    input.checked = true;
                    input.id = 'det' + i;
                    input.addEventListener('change', () => { b._skip = !input.checked; render(); });
                    const label = document.createElement('label');
                    label.className = 'form-check-label';
                    label.htmlFor = 'det' + i;
                    label.textContent = areaText(b);
                    label.addEventListener('mouseenter', () => { b._hover = true; render(); });
                    label.addEventListener('mouseleave', () => { b._hover = false; render(); });
                    div.appendChild(input);
                    div.appendChild(label);
                    list.appendChild(div);
                });
                const confirmBtn = document.getElementById('detectConfirm');
                confirmBtn.className = 'btn btn-' + (isLogos ? 'warning' : 'danger');
                confirmBtn.textContent = isLogos ? 'Remove selected logos' : 'Erase selected areas';
                render();
                modal.show();
            }

            function areaText(b) {
                return (TOOLS[b.type] ? TOOLS[b.type].label : b.type) +
                    ' · x ' + Math.round(b.x * 100) + '% · y ' + Math.round(b.y * 100) + '%' +
                    ' · ' + Math.round(b.w * 100) + '% × ' + Math.round(b.h * 100) + '%';
            }

            const detectModalEl = document.getElementById('detectModal');
            modal = new bootstrap.Modal(detectModalEl);

            document.getElementById('detectConfirm').addEventListener('click', () => {
                pending.forEach(b => {
                    if (!b._skip) {
                        boxes.push({ type: b.type, x: b.x, y: b.y, w: b.w, h: b.h });
                    }
                });
                pending = [];
                sync();
                modal.hide();
            });

            detectModalEl.addEventListener('hidden.bs.modal', () => {
                pending = [];
                render();
            });

            // ------------------------------------------------ AI assistant

            const aiText = document.getElementById('aiText');
            const aiApply = document.getElementById('aiApply');
            const aiMsg = document.getElementById('aiMsg');
            const aiThumb = document.getElementById('aiThumb');
            const aiResultWrap = document.getElementById('aiResultWrap');

            document.querySelectorAll('#aiChips button').forEach(chip => {
                chip.addEventListener('click', () => { aiText.value = chip.textContent.trim(); aiApply.click(); });
            });

            function token() {
                return document.querySelector('input[name="__RequestVerificationToken"]').value;
            }

            function showAiMsg(text, ok) {
                aiMsg.classList.remove('d-none', 'alert-success', 'alert-warning');
                aiMsg.classList.add(ok ? 'alert-success' : 'alert-warning');
                aiMsg.textContent = text;
            }

            aiApply.addEventListener('click', () => {
                const file = fileInput.files && fileInput.files[0];
                const instruction = aiText.value.trim();
                if (!file) { showAiMsg('Choose a poster image first.', false); return; }
                if (!instruction) { showAiMsg('Type what you want changed, e.g. "remove all text and make it blue".', false); return; }

                aiApply.disabled = true;
                const oldLabel = aiApply.textContent;
                aiApply.textContent = 'Thinking…';
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token());
                fd.append('upload', file);
                fd.append('instruction', instruction);

                fetch('/Templates/AiUpdate', { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(data => {
                        if (!data.ok) { showAiMsg(data.message || 'Could not apply that.', false); return; }
                        showAiMsg(data.message, true);
                        if (data.image) {
                            aiThumb.src = data.image;
                            aiResultWrap.classList.remove('d-none');
                        }
                        boxes = (data.boxes || []).map(b => ({ type: b.type, x: b.x, y: b.y, w: b.w, h: b.h }));
                        if (data.treatment) setTreatment(data.treatment);
                        invalidateTreatPreview();
                        sync();
                    })
                    .catch(() => showAiMsg('Something went wrong applying that instruction.', false))
                    .finally(() => {
                        aiApply.disabled = false;
                        aiApply.textContent = oldLabel;
                    });
            });

            // ------------------------------------------------ colour treatments

            const tintControls = document.getElementById('tintControls');
            const freshControls = document.getElementById('freshControls');
            const tintHex = document.getElementById('tintHex');
            const tintRange = document.getElementById('tintStrengthRange');
            const tintLabel = document.getElementById('tintStrengthLabel');
            const tintHidden = document.getElementById('TintStrength');
            const freshThemeSel = document.getElementById('freshTheme');
            const freshAccent = document.getElementById('freshAccent');

            function currentKind() {
                const el = document.querySelector('input[name="TreatmentKind"]:checked');
                return el ? el.value : 'original';
            }

            function updateTreatmentControls() {
                const kind = currentKind();
                tintControls.classList.toggle('d-none', kind !== 'tint');
                freshControls.classList.toggle('d-none', kind !== 'fresh');
                tintLabel.textContent = tintRange.value + '%';
                tintHidden.value = (parseInt(tintRange.value, 10) / 100).toFixed(2);
            }

            function setTreatment(t) {
                const kind = t.kind || 'original';
                document.querySelectorAll('.treat-radio').forEach(r => { r.checked = r.value === kind; });
                if (t.tintHex) tintHex.value = t.tintHex;
                if (typeof t.tintStrength === 'number') tintRange.value = Math.round(t.tintStrength * 100);
                if (t.freshTheme) freshThemeSel.value = t.freshTheme;
                if (t.freshAccent) freshAccent.value = t.freshAccent;
                updateTreatmentControls();
            }

            document.querySelectorAll('.treat-radio').forEach(r =>
                r.addEventListener('change', () => { updateTreatmentControls(); invalidateTreatPreview(); }));
            [tintHex, tintRange, freshThemeSel, freshAccent].forEach(el =>
                el.addEventListener('input', () => { updateTreatmentControls(); invalidateTreatPreview(); }));

            const btnTreatPreview = document.getElementById('btnTreatPreview');
            const treatThumb = document.getElementById('treatThumb');
            const treatThumbWrap = document.getElementById('treatThumbWrap');
            const treatNote = document.getElementById('treatNote');
            let treatUrl = '';

            function invalidateTreatPreview() {
                if (treatUrl) { URL.revokeObjectURL(treatUrl); treatUrl = ''; }
                treatThumbWrap.classList.add('d-none');
                treatNote.classList.add('d-none');
            }

            btnTreatPreview.addEventListener('click', () => {
                const file = fileInput.files && fileInput.files[0];
                if (!file) { alert('Choose a poster image first.'); return; }
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token());
                fd.append('upload', file);
                const t = {
                    kind: currentKind(),
                    tintHex: tintHex.value,
                    strength: (parseInt(tintRange.value, 10) / 100).toFixed(2),
                    freshTheme: freshThemeSel.value,
                    freshAccent: freshAccent.value
                };
                fd.append('kind', t.kind);
                fd.append('tintHex', t.tintHex);
                fd.append('strength', t.strength);
                fd.append('freshTheme', t.freshTheme);
                fd.append('freshAccent', t.freshAccent);

                btnTreatPreview.disabled = true;
                fetch('/Templates/PreviewTreatment', { method: 'POST', body: fd })
                    .then(r => { if (!r.ok) throw new Error('preview failed'); return r.blob(); })
                    .then(blob => {
                        if (treatUrl) URL.revokeObjectURL(treatUrl);
                        treatUrl = URL.createObjectURL(blob);
                        treatThumb.src = treatUrl;
                        treatThumbWrap.classList.remove('d-none');
                        treatNote.classList.remove('d-none');
                    })
                    .catch(() => alert('Could not build the preview.'))
                    .finally(() => { btnTreatPreview.disabled = false; });
            });

            updateTreatmentControls();
        })();
    </script>
}
